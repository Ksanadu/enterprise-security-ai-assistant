# =============================================================================
# Enterprise Security AI Assistant - environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env            (bash)
#     Copy-Item .env.example .env     (PowerShell)
#
# NEVER commit the resulting `.env` file. `.gitignore` already excludes it.
# NEVER put a real production API key in this template.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Enterprise Security AI Assistant"
# development | staging | production
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text            # text | json  (use json in production)

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed browser origins for CORS.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of this process.
#
#   0 = the API is reachable directly. X-Forwarded-For is IGNORED, so a client
#       cannot forge the address it is audited and rate-limited under.
#   1 = exactly one proxy (nginx in the Docker deployment, which sets this to 1).
#
# This is a claim about your deployment, not about a request. Leaving it at 0
# behind a proxy makes every request look like it came from the proxy, collapsing
# the per-address sign-in lockout into one shared bucket and recording the proxy
# instead of the client in the audit trail. Setting it too high would start
# trusting values a client can forge.
TRUSTED_PROXY_COUNT=0

# -----------------------------------------------------------------------------
# Docker Compose (docker-compose.yml)
# -----------------------------------------------------------------------------
# These four are read by Compose itself - from your shell, or from this file,
# which Compose loads automatically - and are never passed to the application.
# They exist because the compose file needs the same values for its port
# mappings and for the CORS origin the browser will use; deriving one from the
# other is what stops them disagreeing.
#
#   ESAA_HTTP_PORT    host port for the application (nginx).        default 8080
#   ESAA_API_PORT     host port for the API, bound to loopback.     default 8000
#   ESAA_CORS_ORIGINS the origins the browser may call the API from directly.
#                     Leave it unset: the compose default already matches the
#                     two ports above, and the normal path is same-origin
#                     through nginx, which needs no CORS at all.
#
# `docker compose up --build` needs none of them, and needs no `.env` file.
ESAA_HTTP_PORT=8080
ESAA_API_PORT=8000

# -----------------------------------------------------------------------------
# Database (SQLite for the MVP)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# REQUIRED outside development. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Leave the placeholder below and a random key is generated for the lifetime of
# the process (safe default; sessions end when the backend restarts).
AUTH_SECRET_KEY=dev-only-insecure-change-me
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Demo login is enabled only when APP_ENV=development and this flag is true.
ALLOW_DEMO_LOGIN=true

# Brute-force protection. Attempts are counted per account and per source
# address over the window; exceeding either locks sign-in for the lockout.
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_MAX_LOGIN_ATTEMPTS_PER_IP=20
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
# Revoked/expired session rows are kept as evidence for this long.
AUTH_SESSION_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Demo data (all data in this project is simulated - no real enterprise data)
# -----------------------------------------------------------------------------
# Seeding is refused when APP_ENV=production.
SEED_DEMO_USERS=true
# Demo-only credential for the seeded accounts. Change it, or disable seeding.
DEMO_USER_PASSWORD=Demo@12345

# -----------------------------------------------------------------------------
# LLM provider (OpenAI-compatible chat completions endpoint)
# -----------------------------------------------------------------------------
# mock = deterministic offline provider, needs no API key (used by tests/demo)
# openai_compatible = any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# tfidf             = offline lexical vector-space model, fitted on the knowledge
#                     base. No network, no API key, fully reproducible (default).
# openai_compatible = semantic embeddings from a hosted /embeddings endpoint.
#
# The model is a quality/offline trade-off, not a security setting: retrieval
# authorisation is enforced independently of the embedding provider.
EMBEDDING_PROVIDER=tfidf
EMBEDDING_MODEL=text-embedding-3-small
# Used only by hosted embedding models; the offline provider derives its
# dimension from the fitted vocabulary.
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Safety valve on the fitted vocabulary size.
EMBEDDING_MAX_FEATURES=20000

# -----------------------------------------------------------------------------
# Vector store
# -----------------------------------------------------------------------------
# faiss  = FAISS in-process index persisted under VECTOR_STORE_PATH
# memory = pure-Python/NumPy fallback (always available)
VECTOR_STORE=faiss
VECTOR_STORE_PATH=./data/vector_store

# -----------------------------------------------------------------------------
# Knowledge base + retrieval
# -----------------------------------------------------------------------------
KB_DIR=./knowledge_base
# Strict validation refuses to start when a document's metadata is malformed.
# Keep this true outside development: a silently skipped document silently
# changes what the assistant is allowed to answer.
KB_STRICT_VALIDATION=true
RETRIEVAL_TOP_K=6
# Absolute cosine floor. Low by design: the relative floor below does most of
# the precision work, and this only rejects obviously unrelated chunks.
RETRIEVAL_MIN_SCORE=0.05
# Drop matches scoring below this fraction of the best match. Tuned against the
# evaluation set (tests/data/evaluation_questions.json): 0.7 recalled the
# expected document for 86% of questions, 0.5 recalls 97%, with an irrelevant
# question still returning nothing either way.
RETRIEVAL_RELATIVE_FLOOR=0.5
# At most this many chunks from one document, so one verbose document cannot
# crowd out the second-best source.
RETRIEVAL_MAX_PER_DOCUMENT=2
# Hard cap on context characters injected into the LLM prompt.
RETRIEVAL_MAX_CONTEXT_CHARS=6000
# Chunking: size budget per chunk and the overlap carried across boundaries.
RAG_CHUNK_MAX_CHARS=700
RAG_CHUNK_OVERLAP_CHARS=100

# -----------------------------------------------------------------------------
# Guardrails
# -----------------------------------------------------------------------------
MAX_QUERY_LENGTH=2000
# Requests per minute per user for the chat endpoint.
CHAT_RATE_LIMIT_PER_MINUTE=20
# Allow the language model to refine intent classification and to RAISE a risk
# level. It can never lower one, and escalation is decided by backend rules.
# Ignored when LLM_PROVIDER=mock.
CLASSIFIER_USE_LLM=true
