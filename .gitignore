frontend/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Runtime data (SQLite DBs, vector index, logs) ----
data/
# ...except the evaluation set, which is a source fixture that happens to sit
# under a directory called `data/`. Git cannot re-include a file whose parent
# directory is excluded, so the directory is re-included first. Without this the
# 40-question evaluation set is untracked and a fresh clone fails the whole
# evaluation suite - which is exactly what happened.
!backend/tests/data/
!backend/tests/data/**
*.db
*.db-journal
*.sqlite
*.sqlite3
*.faiss
*.index
# A vector index is written wherever VECTOR_STORE_PATH points, which an
# operator may change. Ignore the directory by name so a generated index can
# never be committed, wherever it ends up.
vector_store/
logs/
*.log

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Unrelated pre-existing local files (not part of this project) ----
old/
