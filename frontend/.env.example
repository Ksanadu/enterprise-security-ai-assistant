# =============================================================================
# Frontend environment template - copy to `.env.local` and adjust.
# -----------------------------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put an API key, token or any secret in this file.
# =============================================================================

# Leave empty to call the API on the same origin (recommended: the dev server
# proxies /api to the backend, and in Docker nginx does the same).
VITE_API_BASE_URL=

# Title shown in the application header.
VITE_APP_TITLE=Enterprise Security AI Assistant

# --- Development server only -------------------------------------------------
# Where `npm run dev` proxies /api requests.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
VITE_DEV_PORT=5173
